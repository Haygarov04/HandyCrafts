# Copy to .env.local for local work. On Vercel: Project → Settings → Environment Variables.

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.bg

# /manage login (the password you already set) + a long random string that signs the login cookie
CRM_PASSWORD=
SESSION_SECRET=

# AI preview (xAI Grok image edits)
XAI_API_KEY=
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
# PREVIEW_HOURLY_LIMIT=8
# PREVIEW_DAILY_LIMIT=300

# Added automatically when you connect the stores in Vercel → Storage
REDIS_URL=
BLOB_READ_WRITE_TOKEN=

# Push notifications for /manage (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:handycraftshelp@gmail.com

# E-mails through Resend (resend.com): order confirmations, status updates, contact form
RESEND_API_KEY=
EMAIL_FROM=HandyCrafts <orders@handy-crafts.digital>
CONTACT_TO=handycraftshelp@gmail.com
# Optional: Google review link used in the "delivered" email
GOOGLE_REVIEW_URL=

# Optional SMTP fallback when RESEND_API_KEY is not set
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Daily cleanup of old photos (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Seller details shown in the footer and legal pages
LEGAL_NAME=
LEGAL_EIK=
LEGAL_VAT=
LEGAL_ADDRESS=
LEGAL_PHONE=
LEGAL_EMAIL=handycraftshelp@gmail.com
