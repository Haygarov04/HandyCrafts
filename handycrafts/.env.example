# Copy to .env.local for local work. On Vercel: Project → Settings → Environment Variables.

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.bg

# /manage login (the password you already set) + a long random string that signs the login cookie
CRM_PASSWORD=
SESSION_SECRET=

# AI preview (xAI Grok image edits)
XAI_API_KEY=
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
# PREVIEW_HOURLY_LIMIT=8
# PREVIEW_DAILY_LIMIT=300

# Added automatically when you connect the stores in Vercel → Storage
REDIS_URL=
BLOB_READ_WRITE_TOKEN=

# Push notifications for /manage (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:handycraftshelp@gmail.com

# E-mails (optional): order copy to you and confirmation to the customer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=handycraftshelp@gmail.com
